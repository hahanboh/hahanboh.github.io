---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getPublishedWriting, getPublishedCollection, byDate, projectPath, researchPath } from '../lib/content';
import { site } from '../data/site';
import { sitePath } from '../lib/urls';
import Icon from '../components/chrome/Icon.astro';

const writing = await getPublishedWriting();
const featured = writing.filter((entry) => entry.data.featured).slice(0, 3);
const recent = writing.slice(0, 4);
const allProjects = byDate(await getPublishedCollection('projects'));
const allResearch = byDate(await getPublishedCollection('research'));
const projects = allProjects.slice(0, 2);
const research = allResearch.slice(0, 2);

const focusAreas = [
  {
    label: '英语笔记',
    title: '把英语学习整理成可复习的材料',
    description: '整理词汇、语法、阅读、听力和表达练习，把零散记录变成之后能继续复习的笔记。',
    href: sitePath('/writing/'),
    action: '查看笔记',
    icon: 'bookmark',
  },
  {
    label: '学习记录',
    title: '把输入变成长期知识',
    description: '保留课程、阅读、论文和技术实践中的关键概念，也保留自己的理解过程。',
    href: sitePath('/writing/'),
    action: '浏览全部',
    icon: 'check',
  },
  {
    label: '研究成果',
    title: '整理可以被引用的成果',
    description: '集中放置研究问题、阶段版本、数据说明和方法复盘，让成果有清晰来处。',
    href: sitePath('/research/'),
    action: '查看成果',
    icon: 'arrowUpRight',
  },
];

const signals = [
  { value: writing.length, label: '篇公开笔记' },
  { value: allResearch.length, label: '项研究记录' },
  { value: allProjects.length, label: '个项目条目' },
];
---
<BaseLayout>
  <section class="hero-shell">
    <div class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">Personal Knowledge Site</p>
        <h1>{site.name}</h1>
        <p class="lede">{site.description}</p>
        <div class="hero-actions" aria-label="主要入口">
          <a class="primary-link" href={sitePath('/start/')}>从阅读地图开始 <Icon name="arrowRight" size="sm" /></a>
          <a class="secondary-link" href={sitePath('/research/')}>看研究成果</a>
        </div>
      </div>
      <div class="study-panel" aria-label="站点概览">
        <div class="panel-top">
          <p class="eyebrow">当前结构</p>
          <span>持续建设中</span>
        </div>
        <div class="signal-grid">
          {signals.map((item) => (
            <div>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
        <div class="route-list">
          <a href={sitePath('/writing/')}>英语笔记 <Icon name="arrowRight" size="sm" /></a>
          <a href={sitePath('/research/')}>研究成果 <Icon name="arrowRight" size="sm" /></a>
          <a href={sitePath('/projects/')}>项目实践 <Icon name="arrowRight" size="sm" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="container focus-section">
    <div class="section-heading">
      <h2><span>01 /</span> 站点方向</h2>
      <p>先从英语笔记开始，把内容整理成自己愿意反复打开的学习档案。</p>
    </div>
    <div class="focus-grid">
      {focusAreas.map((item) => (
        <article class="focus-card">
          <div class="focus-icon"><Icon name={item.icon} /></div>
          <p class="eyebrow">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <a href={item.href}>{item.action} <Icon name="arrowRight" size="sm" /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="container content-grid">
    <div class="writing-column">
      <div class="section-heading compact">
        <h2><span>02 /</span> 最近更新</h2>
        <a href={sitePath('/writing/')}>全部 {writing.length} 篇 <Icon name="arrowRight" size="sm" /></a>
      </div>
      {featured.length > 0 && (
        <div class="featured-strip">
          <p class="eyebrow">精选</p>
          <div class="featured-list">
            {featured.map((entry) => <PostCard entry={entry} />)}
          </div>
        </div>
      )}
      <div class="list recent-list">
        {recent.map((entry) => <PostCard entry={entry} />)}
      </div>
    </div>

    <aside class="side-column" aria-label="研究与项目">
      <div class="mini-section">
        <div class="section-heading compact">
          <h2><span>03 /</span> 研究</h2>
          <a href={sitePath('/research/')}>查看 <Icon name="arrowRight" size="sm" /></a>
        </div>
        <div class="stack-list">
          {research.map((entry) => (
            <article>
              <p class="eyebrow">{entry.data.kind} · v{entry.data.version}</p>
              <h3><a href={researchPath(entry)}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="mini-section">
        <div class="section-heading compact">
          <h2><span>04 /</span> 项目</h2>
          <a href={sitePath('/projects/')}>查看 <Icon name="arrowRight" size="sm" /></a>
        </div>
        <div class="stack-list">
          {projects.map((entry) => (
            <article>
              <p class="eyebrow">{entry.data.status}</p>
              <h3><a href={projectPath(entry)}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero-shell {
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 42%),
      linear-gradient(180deg, var(--paper), var(--paper-2));
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: calc(100svh - 5rem);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .hero h1 {
    max-width: 11ch;
    margin: .55rem 0 1rem;
    font-size: clamp(3.2rem, 9vw, 7.4rem);
    line-height: .95;
    letter-spacing: 0;
  }

  .lede {
    max-width: 43rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.8rem;
  }

  .primary-link,
  .secondary-link,
  .focus-card a,
  .section-heading a,
  .route-list a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    text-decoration: none;
  }

  .primary-link {
    min-height: 2.7rem;
    padding: .55rem .9rem;
    border: 1px solid var(--ink);
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }

  .secondary-link {
    min-height: 2.7rem;
    padding: .55rem .9rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-weight: 700;
  }

  .study-panel,
  .focus-card,
  .stack-list article {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 18px 50px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .study-panel {
    padding: clamp(1rem, 3vw, 1.4rem);
  }

  .panel-top,
  .signal-grid {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .panel-top span {
    color: var(--muted);
    font-size: .9rem;
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1rem 0;
    border-block: 1px solid var(--line);
  }

  .signal-grid div {
    min-height: 7rem;
    padding: 1rem .75rem;
    border-right: 1px solid var(--line);
  }

  .signal-grid div:last-child {
    border-right: 0;
  }

  .signal-grid strong {
    display: block;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
  }

  .signal-grid span,
  .route-list a {
    color: var(--muted);
    font-size: .92rem;
  }

  .route-list {
    display: grid;
    gap: .55rem;
  }

  .route-list a {
    justify-content: space-between;
    padding: .55rem 0;
    border-bottom: 1px solid var(--line);
  }

  .focus-section {
    padding: clamp(3rem, 8vw, 5rem) 0 0;
  }

  .section-heading p {
    max-width: 30rem;
    margin: 0;
    color: var(--muted);
    font-size: .95rem;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.3rem;
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    min-height: 19rem;
    padding: 1.15rem;
  }

  .focus-icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    margin-bottom: 1.2rem;
    border-radius: 50%;
    background: var(--soft);
    color: var(--accent);
  }

  .focus-card h3 {
    margin: .45rem 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .focus-card p:not(.eyebrow) {
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .focus-card a {
    margin-top: auto;
    color: var(--accent);
    font-weight: 700;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .75fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(3rem, 8vw, 5rem) 0;
  }

  .compact {
    margin-top: 0;
  }

  .featured-strip {
    margin: 1.25rem 0 1.75rem;
    padding: .8rem 1rem .3rem;
    border-left: 4px solid var(--accent);
    background: var(--paper-2);
  }

  .recent-list {
    border-top: 1px solid var(--line);
  }

  .side-column,
  .stack-list {
    display: grid;
    gap: 1rem;
  }

  .mini-section {
    display: grid;
    gap: 1rem;
  }

  .stack-list article {
    padding: 1rem;
    box-shadow: none;
  }

  .stack-list h3 {
    margin: .3rem 0 .45rem;
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .stack-list h3 a {
    text-decoration: none;
  }

  .stack-list h3 a:hover {
    text-decoration: underline;
  }

  .stack-list p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: .93rem;
  }

  @media (max-width: 58rem) {
    .hero,
    .content-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .signal-grid {
      grid-template-columns: 1fr;
    }

    .signal-grid div {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .signal-grid div:last-child {
      border-bottom: 0;
    }
  }
</style>
